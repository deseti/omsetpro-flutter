// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============== AUTH & USER MODELS ==============
model User {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique
  namaLengkap         String
  password            String
  role                Role                @default(OWNER)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  // Relasi untuk multi-tenancy (OWNER mengelola tim)
  dikelolaOlehId      Int?
  dikelolaOleh        User?               @relation("OwnerMengelolaTim", fields: [dikelolaOlehId], references: [id])
  tim                 User[]              @relation("OwnerMengelolaTim")
  // Relasi ke data yang dimiliki oleh OWNER
  cabangDimiliki      Cabang[]            @relation("OwnerMilikiCabang")
  pelanggan           Pelanggan[]         @relation("OwnerMilikiPelanggan")
  loyaltyRule         LoyaltyRule?        @relation("OwnerLoyaltyRule")
  rewards             Reward[]            @relation("OwnerRewards")
  promos              Promo[]             // [BARU] Relasi ke Promo
  akunToko            AkunToko?           @relation("OwnerAkunToko")
  // Relasi untuk hak akses sebagai kasir/admin
  aksesCabang         AksesCabang[]
  transaksiKasir      Transaksi[]         @relation("KasirBuatTransaksi")
  // Relasi untuk fitur tambahan tim/karyawan
  absensi             Absensi[]           @relation("UserAbsensi")
  jadwalTim           JadwalTim[]         @relation("UserJadwal")
  gajiTim             GajiTim?            @relation("UserGaji")
  auditLogs           AuditLog[]          @relation("UserAuditLog")
  izinTim             IzinTim[]           @relation("UserIzinTim")
  izinTimApproved     IzinTim[]           @relation("UserApproveIzin")
  notifikasi          Notifikasi[]        @relation("UserNotifikasi")
}

enum Role {
  OWNER
  ADMIN
  KASIR
}

// ============== CABANG & AKSES ==============
model Cabang {
  id            Int           @id @default(autoincrement())
  nama          String
  alamat        String
  industri      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Relasi ke Owner
  ownerId       Int
  owner         User          @relation("OwnerMilikiCabang", fields: [ownerId], references: [id])
  // Relasi ke data di dalam cabang
  produk        Produk[]
  transaksi     Transaksi[]
  aksesPengguna AksesCabang[]
  // Relasi untuk fitur tambahan tim/karyawan
  absensi       Absensi[]     @relation("CabangAbsensi")
  shift         Shift[]       @relation("CabangShift")
}

model AksesCabang {
  userId   Int
  cabangId Int
  user     User   @relation(fields: [userId], references: [id])
  cabang   Cabang @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@id([userId, cabangId])
}

// ============== PRODUK ==============
model Produk {
  id              Int               @id @default(autoincrement())
  nama            String
  kategori        String?
  hargaBeli       Int               @default(0)
  harga           Int
  stok            Int               @default(0)
  barcode         String?           @unique
  fotoUrl         String?
  isArsip         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // Relasi ke Cabang
  cabangId        Int
  cabang          Cabang            @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  // Relasi ke detail transaksi
  transaksiDetail TransaksiDetail[]
  // [BARU] Relasi ke Promo
  promos          ProdukPromo[]
}

// ============== TRANSAKSI ==============
model Transaksi {
  id            Int               @id @default(autoincrement())
  total         Int
  metodeBayar   String
  createdAt     DateTime          @default(now())
  // [BARU] Field untuk Midtrans integration
  orderId       String?           @unique  // Order ID dari Midtrans
  status        String            @default("pending") // pending, paid, failed, cancelled
  // [BARU] Informasi diskon
  potongan      Int               @default(0)
  // [BARU] Sumber transaksi & tipe pengiriman untuk Toko Online
  sumberTransaksi String          @default("Kasir") // "Kasir" atau "TokoOnline"
  tipePengiriman  String?         // "Diambil" atau "Diantar" (untuk toko online)
  // [BARU] Data pelanggan toko online (jika tidak terdaftar)
  namaPelangganOnline    String?
  noHpPelangganOnline    String?
  // [BARU] Informasi pengiriman kurir
  nomorResi     String?           // Nomor resi pengiriman
  namaKurir     String?           // Nama jasa pengiriman (JNE, JT Express, dll)
  // Relasi ke Cabang & Kasir
  cabangId      Int
  cabang        Cabang            @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  kasirId       Int
  kasir         User              @relation("KasirBuatTransaksi", fields: [kasirId], references: [id])
  // Relasi ke Detail
  detail        TransaksiDetail[]
  // Relasi ke Pelanggan (opsional)
  pelangganId   Int?
  pelanggan     Pelanggan?        @relation(fields: [pelangganId], references: [id])
  // Relasi ke PointHistory
  pointHistory  PointHistory?
}

model TransaksiDetail {
  id           Int       @id @default(autoincrement())
  jumlah       Int
  hargaSaatItu Int
  // [BARU] Informasi diskon per item
  potonganItem Int       @default(0)
  // Relasi ke Transaksi & Produk
  transaksiId  Int
  transaksi    Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  produkId     Int
  produk       Produk    @relation(fields: [produkId], references: [id])
}

// ============== PELANGGAN (CRM) ==============
model Pelanggan {
  id           Int            @id @default(autoincrement())
  nama         String
  noHp         String
  email        String?
  alamat       String?
  totalPoin    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // Relasi ke Owner yang memiliki data pelanggan ini
  ownerId      Int
  owner        User           @relation("OwnerMilikiPelanggan", fields: [ownerId], references: [id])
  // Relasi ke transaksi yang dilakukan pelanggan
  transaksi    Transaksi[]
  // Relasi ke riwayat poin
  pointHistory PointHistory[]

  @@unique([ownerId, noHp])
}

// ============== LOYALITAS & POIN ==============
model LoyaltyRule {
  id          Int      @id @default(autoincrement())
  ownerId     Int      @unique
  owner       User     @relation("OwnerLoyaltyRule", fields: [ownerId], references: [id])
  kelipatanRp Int
  dapatPoin   Int
  updatedAt   DateTime @updatedAt
}

model Reward {
  id             Int      @id @default(autoincrement())
  ownerId        Int
  owner          User     @relation("OwnerRewards", fields: [ownerId], references: [id])
  namaHadiah     String
  poinDibutuhkan Int
  deskripsi      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PointHistory {
  id          Int       @id @default(autoincrement())
  pelangganId Int
  pelanggan   Pelanggan @relation(fields: [pelangganId], references: [id])
  poin        Int
  tipe        String
  deskripsi   String
  createdAt   DateTime  @default(now())
  transaksiId Int?      @unique
  transaksi   Transaksi? @relation(fields: [transaksiId], references: [id])
}

// ============== [BARU] PROMO & DISKON ==============
model Promo {
  id          Int         @id @default(autoincrement())
  ownerId     Int
  owner       User        @relation(fields: [ownerId], references: [id])
  nama        String
  deskripsi   String?
  tipe        PromoTipe
  nilai       Float       // Untuk PERCENTAGE (e.g., 15 for 15%) atau NOMINAL (e.g., 5000)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Relasi Many-to-Many dengan Produk
  produk      ProdukPromo[]
}

// Tabel penghubung untuk relasi Many-to-Many antara Promo dan Produk
model ProdukPromo {
  promoId  Int
  promo    Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  produkId Int
  produk   Produk @relation(fields: [produkId], references: [id], onDelete: Cascade)

  @@id([promoId, produkId])
}

enum PromoTipe {
  PERCENTAGE // Diskon persen untuk produk tertentu
  NOMINAL    // Diskon nominal untuk produk tertentu
}

// ============== FITUR TAMBAHAN UNTUK TIM (KARYAWAN) ==============
// Absensi tim/karyawan
model Absensi {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserAbsensi", fields: [userId], references: [id])
  cabangId  Int
  cabang    Cabang   @relation("CabangAbsensi", fields: [cabangId], references: [id])
  tanggal   DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    AbsensiStatus @default(TIDAK_HADIR)
  catatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cabangId, tanggal])
}

enum AbsensiStatus {
  HADIR
  TIDAK_HADIR
  IZIN
  SAKIT
  CUTI
}

// Shift/Jadwal kerja untuk tim
model Shift {
  id          Int       @id @default(autoincrement())
  nama        String    // "Pagi", "Siang", "Malam"
  jamMulai    String    // "08:00"
  jamSelesai  String    // "16:00"
  cabangId    Int
  cabang      Cabang    @relation("CabangShift", fields: [cabangId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relasi ke jadwal tim
  jadwalTim JadwalTim[]
}

model JadwalTim {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation("UserJadwal", fields: [userId], references: [id])
  shiftId  Int
  shift    Shift    @relation(fields: [shiftId], references: [id])
  tanggal  DateTime
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tanggal])
}

// Pengaturan gaji dan komisi untuk tim
model GajiTim {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation("UserGaji", fields: [userId], references: [id])
  gajiPokok     Int      @default(0)
  komisiPersen  Float    @default(0) // Komisi dari penjualan (%)
  komisiNominal Int      @default(0) // Komisi tetap per transaksi
  tunjangan     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Log audit aktivitas
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserAuditLog", fields: [userId], references: [id])
  aksi      String   // "LOGIN", "LOGOUT", "CREATE_TRANSAKSI", "UPDATE_PRODUK", dll
  modul     String   // "AUTH", "TRANSAKSI", "PRODUK", "CABANG", dll
  detail    String?  // JSON atau text detail
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// Izin cuti/sakit untuk tim
model IzinTim {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation("UserIzinTim", fields: [userId], references: [id])
  tipe        TipeIzin
  tanggalMulai DateTime
  tanggalSelesai DateTime
  alasan      String
  status      StatusIzin  @default(PENDING)
  approvedBy  Int?
  approver    User?       @relation("UserApproveIzin", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  catatan     String?     // Catatan dari approver
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum TipeIzin {
  CUTI
  SAKIT
  IZIN_KHUSUS
}

enum StatusIzin {
  PENDING
  APPROVED
  REJECTED
}

// Notifikasi dan reminder
model Notifikasi {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation("UserNotifikasi", fields: [userId], references: [id])
  tipe      TipeNotifikasi
  judul     String
  pesan     String
  isRead    Boolean         @default(false)
  data      String?         // JSON data tambahan
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum TipeNotifikasi {
  SHIFT_REMINDER
  IZIN_REQUEST
  IZIN_APPROVED
  IZIN_REJECTED
  SYSTEM
  GENERAL
}

// ============== PENGATURAN AKUN TOKO ==============
model AkunToko {
  id             Int     @id @default(autoincrement())
  ownerId        Int     @unique
  owner          User    @relation("OwnerAkunToko", fields: [ownerId], references: [id], onDelete: Cascade)
  nama           String
  logoUrl        String?
  alamat         String
  telepon        String
  email          String
  kategoriBisnis String
  // [BARU] Pengaturan Toko Online & QR Order
  tokoOnlineSlug        String?  @unique  // Link unik untuk toko online (contoh: "kopi-bahagia")
  isTokoOnlineActive    Boolean  @default(false)  // Aktif/nonaktif toko online
  allowPickup           Boolean  @default(true)   // Izinkan "Ambil di Tempat"
  allowDelivery         Boolean  @default(false)  // Izinkan "Diantar Kurir"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Relasi ke rekening bank
  rekeningBank   RekeningBank[]
}

// ============== [BARU] REKENING BANK TOKO ==============
model RekeningBank {
  id            Int      @id @default(autoincrement())
  akunTokoId    Int
  akunToko      AkunToko @relation(fields: [akunTokoId], references: [id], onDelete: Cascade)
  namaBank      String   // Contoh: "BCA", "Mandiri", "BRI"
  nomorRekening String
  namaPemilik   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}